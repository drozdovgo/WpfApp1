<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Factory Method Demo" Height="350" Width="525">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <Label Content="Выберите цвет:" VerticalAlignment="Center"/>
            <ComboBox x:Name="ColorComboBox" Width="120" Margin="5,0,0,0" 
                      SelectedIndex="0">
                <ComboBoxItem Content="Красный"/>
                <ComboBoxItem Content="Чёрный"/>
                <ComboBoxItem Content="Синий"/>
            </ComboBox>
        </StackPanel>

        <Canvas x:Name="DrawingCanvas" Grid.Row="1" Background="LightGray"/>
    </Grid>
</Window>